  "cases": [
    {
      "name": "portrait-single decode",
      "hook": "protocols",
      "args": [
        {
          "model": "omni-fast-no-water",
          "body": {
            "kind": "json",
            "value": {
              "model": "omni-fast-no-water",
              "prompt": "  保留原始提示词  ",
              "aspect_ratio": "9:16",
              "image_url": "https://example.invalid/ref.png",
              "metadata": {
                "keep": true
              }
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "omni-fast-no-water",
        "action": "image_to_video",
        "requestBody": {
          "model": "omni-fast-no-water",
          "prompt": "  保留原始提示词  ",
          "aspect_ratio": "9:16",
          "image_url": "https://example.invalid/ref.png",
          "metadata": {
            "keep": true
          }
        }
      },
      "path": [
        "openai_video",
        "decodeRequest"
      ]
    },
