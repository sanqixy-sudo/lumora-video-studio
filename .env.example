APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=sora_session
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://sora:sora_password@127.0.0.1:5432/sora
POSTGRES_DB=sora
POSTGRES_USER=sora
POSTGRES_PASSWORD=sora_password
FILES_UPLOAD_DIR=/data/uploads
FILES_OUTPUT_DIR=/data/outputs
FILES_TEMP_DIR=/data/temp
LOG_DIR=/data/logs
KEY_ENCRYPTION_SECRET_FILE=/data/secrets/key_secret
DEFAULT_VIDEO_MODEL=sora-2-8s
DEFAULT_VIDEO_SECONDS=12
DEFAULT_VIDEO_SIZE=720x1280
SORA_API_BASE_URL=https://niubi.zeabur.app
SORA_API_HTTP_TIMEOUT=120
SORA_API_STATUS_HTTP_TIMEOUT=30
WORKER_POLL_INTERVAL=2
BOOTSTRAP_ADMIN_USERNAME=sanqi
BOOTSTRAP_ADMIN_PASSWORD=
REFERENCE_IMAGE_MAX_BYTES=20971520
PROVIDER_KEY_FAILURE_THRESHOLD=3
PROVIDER_KEY_COOLDOWN_SECONDS=300

MAX_RUNNING_JOBS=3
SUBMIT_MAX_ATTEMPTS=3
